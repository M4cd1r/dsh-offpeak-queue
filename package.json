{
  "name": "dsh-offpeak-queue",
  "version": "0.1.8",
  "description": "DeepSeek Harness peak-hour message queue: defer selected sends and deliver them to the original conversation off-peak. / DSH 高峰消息暂存与低谷自动投递。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.zh-CN.md",
    "index.js",
    "client.js",
    "src/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check client.js && node --check index.js",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "balance": "node scripts/balance.mjs",
    "verify": "npm run check && npm test && npm run smoke && npm run balance",
    "prepublishOnly": "npm run verify"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TonyNo13/dsh-offpeak-queue.git"
  },
  "homepage": "https://github.com/TonyNo13/dsh-offpeak-queue#readme",
  "bugs": {
    "url": "https://github.com/TonyNo13/dsh-offpeak-queue/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "queue",
    "scheduler",
    "off-peak"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
